{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "settings": { "preset": "desktop", "emulatedFormFactor": "mobile", "throttlingMethod": "simulate" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
